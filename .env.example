# Секреты заполняйте локально, не отправляйте в чат.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# Ваш числовой Telegram ID. При 0 доступна только команда /id.
OWNER_TELEGRAM_ID=0
# Дополнительные пользователи, через запятую. По умолчанию доступ только владельцу.
ALLOWED_TELEGRAM_IDS=
OPENAI_MODEL=gpt-6-luna
TRANSCRIPTION_MODEL=gpt-transcribe
TIMEZONE=Europe/Moscow
# Для сервера: postgresql+psycopg://trainer:password@db:5432/trainer
DATABASE_URL=sqlite:///data/training.sqlite3
DAILY_TOKEN_LIMIT=150000
MAX_VOICE_SECONDS=300
DAILY_AUDIO_SECONDS=1800

# Optional one-way Google Sheets mirror of the owner's journal
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_TAB_ID=0
# Optional second tab for the complete exercise catalog
# GOOGLE_EXERCISES_TAB_ID=123456789
GOOGLE_CREDENTIALS_FILE=google-service-account.json
GOOGLE_SYNC_INTERVAL_SECONDS=60
